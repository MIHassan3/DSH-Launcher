{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the DSH-Dock main (dashboard) window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-sidecar-port",
    "allow-harness-status",
    "allow-harness-start",
    "allow-harness-stop",
    "allow-open-harness-window",
    "allow-close-harness-window"
  ]
}
